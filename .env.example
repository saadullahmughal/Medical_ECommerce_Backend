# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Swagger / OpenAPI
JSON_FILE=swagger.json

# Stripe Payment
STRIPE_PUBLISH_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# JWT Authentication
JWT_TOKEN_SIGNATURE=your_jwt_secret_here
ACCESS_EXPIRY=1d  # Supports 15m, 1h, 2d, etc.

# Password Hashing
BCRYPT_SALT=10  # Use number of rounds or a pre-generated salt string

# Email (SMTP Credentials)
EMAIL_ID=support@example.com
EMAIL_PASSWORD=app_specific_password
EMAIL_TITLE=Your App Notifications

# Vercel Blob Storage
BLOB_BASE_ADDR=https://your-vercel-app.vercel.app
IMAGE_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_example
